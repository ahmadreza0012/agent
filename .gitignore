```gitignore
# Dependencies
__pycache__/
*.pyc
*.pyo
*.pyd

# Results and data files
results/*.json

# Logs
*.log

# Environment
.env
.env.local
*.env.*

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
*.tmp

# OS
.DS_Store
Thumbs.db

# Coverage
.coverage
coverage/
htmlcov/

# Testing
.pytest_cache/
.mypy_cache/
```