```gitignore
# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Dependencies
.venv/
venv/
env/
.env
.env.local
.env.*
requirements.txt.bak

# Testing
.pytest_cache/
.coverage
coverage/
htmlcov/

# Logs
*.log

# Temporary files
*.tmp
*.swp
*~
.DS_Store
Thumbs.db

# IDE specific
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
```