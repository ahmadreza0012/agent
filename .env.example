# Trading System Environment Variables
# =====================================
# Copy this file to .env and fill in values for your environment.
# NEVER commit the .env file with real secrets!

# --- Environment ---
TRADING_ENV=development
TRADING_DEBUG=true
TRADING_LOG_LEVEL=INFO

# --- Trading Mode ---
# Options: backtest, paper, shadow, live
TRADING_MODE=paper

# --- Exchange ---
# Binance (or other supported exchange)
TRADING_EXCHANGE__NAME=binance
TRADING_EXCHANGE__SANDBOX=true
# These should be set via secure secret management in production
TRADING_EXCHANGE__API_KEY=
TRADING_EXCHANGE__API_SECRET=
TRADING_EXCHANGE__API_PASSPHRASE=

# --- Database ---
# PostgreSQL (optional - defaults to SQLite)
TRADING_DATABASE__TYPE=sqlite
TRADING_DATABASE__PATH=data/trading.db
# For PostgreSQL in production:
# TRADING_DATABASE__HOST=localhost
# TRADING_DATABASE__PORT=5432
# TRADING_DATABASE__DATABASE=trading
# TRADING_DATABASE__USER=trading
# TRADING_DATABASE__PASSWORD=

# --- API ---
TRADING_API__HOST=0.0.0.0
TRADING_API__PORT=8000
TRADING_API__RATE_LIMIT=60
TRADING_API__API_KEY=

# --- Alerts ---
TRADING_ALERTS__ENABLED=false
TRADING_ALERTS__MIN_SEVERITY=warning
# Alert channel configurations (set as needed):
# TRADING_ALERTS__SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx
# TRADING_ALERTS__TELEGRAM_BOT_TOKEN=bot_token_here
# TRADING_ALERTS__TELEGRAM_CHAT_ID=chat_id_here
# TRADING_ALERTS__EMAIL_SMTP_SERVER=smtp.gmail.com
# TRADING_ALERTS__EMAIL_SMTP_PORT=587
# TRADING_ALERTS__EMAIL_USERNAME=alerts@example.com
# TRADING_ALERTS__EMAIL_PASSWORD=email_password
# TRADING_ALERTS__EMAIL_FROM=alerts@example.com
# TRADING_ALERTS__EMAIL_TO=admin@example.com

# --- Master Key (for secret encryption) ---
# Generate a secure random key for encrypting secrets at rest
# This can be any secure random string
# TRADING_MASTER_KEY=your_secure_master_key_here
TRADING_SALT=trading_system_salt

# --- Paths ---
TRADING_DATA_DIR=data
TRADING_LOGS_DIR=logs
TRADING_MODELS_DIR=models

# --- Redis (optional) ---
# TRADING_REDIS__HOST=localhost
# TRADING_REDIS__PORT=6379
# TRADING_REDIS__PASSWORD=
# TRADING_REDIS__DB=0
# TRADING_REDIS__SSL=false

# --- ML Configuration ---
TRADING_ML__ENABLED=true
TRADING_ML__MODEL_PATH=models
TRADING_ML__FEATURE_PATH=features
TRADING_ML__RETRAIN_INTERVAL_HOURS=24
TRADING_ML__MIN_TRAINING_SAMPLES=1000

# --- Safety Limits ---
TRADING_LIMITS__MAX_DAILY_LOSS=0.05
TRADING_LIMITS__MAX_TOTAL_DRAWDOWN=0.15
TRADING_LIMITS__MAX_POSITION_SIZE=0.20
TRADING_LIMITS__MAX_EXPOSURE=0.60
TRADING_LIMITS__MAX_LEVERAGE=1.0

# --- Safety Settings ---
TRADING_SAFETY__KILL_SWITCH_ENABLED=true
TRADING_SAFETY__AUTO_DERISK=true
TRADING_SAFETY__HALT_ON_DISCREPANCY=true
TRADING_SAFETY__MAX_API_FAILURES=3
